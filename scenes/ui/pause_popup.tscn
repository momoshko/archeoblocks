[node name="PausePopup" type="Control"]
unique_name_in_owner = true
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")
sound_on_icon = ExtResource("icon_sound_on")
sound_off_icon = ExtResource("icon_sound_off")

[node name="Dimmer" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.054902, 0.0392157, 0.0235294, 0.72)

[node name="PopupCenter" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="PopupPanel" type="PanelContainer" parent="PopupCenter"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2

[node name="PopupLayout" type="VBoxContainer" parent="PopupCenter/PopupPanel"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="PopupCenter/PopupPanel/PopupLayout"]
theme_type_variation = &"HeaderLabel"
layout_mode = 2
theme_override_font_sizes/font_size = 38
text = "Пауза"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="PopupCenter/PopupPanel/PopupLayout"]
theme_type_variation = &"PrimaryButton"
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 68)
layout_mode = 2
text = "Продолжить"
icon = ExtResource("icon_play")

[node name="RestartButton" type="Button" parent="PopupCenter/PopupPanel/PopupLayout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 68)
layout_mode = 2
text = "Начать заново"
icon = ExtResource("icon_restart")

[node name="SoundButton" type="Button" parent="PopupCenter/PopupPanel/PopupLayout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 68)
layout_mode = 2
text = "Звук: вкл."
icon = ExtResource("icon_sound_on")

[node name="MenuButton" type="Button" parent="PopupCenter/PopupPanel/PopupLayout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 68)
layout_mode = 2
text = "В меню"
icon = ExtResource("icon_home")

[node name="PopInMotion" type="Node" parent="."]
script = ExtResource("pop_in")
panel_path = NodePath("../PopupCenter/PopupPanel")
