[node name="ExpeditionSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")
chapter_one_definition = ExtResource("2_chapter_one")
chapter_two_definition = ExtResource("3_chapter_two")
chapter_three_definition = ExtResource("4_chapter_three")

[node name="Background" type="TextureRect" parent="."]
modulate = Color(0.5, 0.48, 0.45, 1)
texture = ExtResource("bg_wall")
