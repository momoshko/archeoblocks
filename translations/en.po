# ---- Tutorial ----
msgid "Главная цель — раскопать артефакт.\nГотовые линии снимают грунт."
msgstr "Your goal is to dig up the artifact.\nCompleted lines remove soil."

msgid "Возьми подсвеченную фигуру."
msgstr "Take the highlighted piece."

msgid "Теперь возьми вторую фигуру."
msgstr "Now take the second piece."

msgid "Осталось закрыть линию этой фигурой."
msgstr "Finish the line with this piece."

msgid "Поставь её в начало строки."
msgstr "Place it at the start of the row."

msgid "Продолжи заполнять ту же строку."
msgstr "Keep filling the same row."

msgid "Заполни последние клетки строки."
msgstr "Fill the last cells of the row."

msgid "Отлично! Линия снимает грунт\nи открывает спрятанную находку."
msgstr "Great! The line removes soil\nand uncovers the hidden find."

msgid "Раскопайте все фрагменты артефакта"
msgstr "Dig up every fragment of the artifact"

msgid "Собирайте строки и столбцы, чтобы снимать грунт"
msgstr "Complete rows and columns to remove soil"


